# Runtime Environment (development | staging | production)
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql+psycopg2://quizclash:quizclash@localhost:5432/quizclash

# CORS Origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# Application Base URL (used in verification & password-reset links)
APP_BASE_URL=http://localhost:5173

# Auth & Cookie Settings
SECRET_KEY=change-me-to-a-long-random-secret
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0 (optional; enables "Continue with Google" when both are set)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# OAUTH_FRONTEND_SUCCESS_PATH=/
# OAUTH_FRONTEND_ERROR_PATH=/login

# Initial Admin Seed (optional; seeded on startup if set)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe123!
# ADMIN_DISPLAY_NAME=Admin

# Initial Regular User Seed (optional; seeded on startup if set)
# DEMO_USER_EMAIL=user@example.com
# DEMO_USER_PASSWORD=UserPassword123
# DEMO_USER_DISPLAY_NAME=Demo User

# SMTP Email Settings (optional; when unset, dev console mailer prints links)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@quizclash.local
# SMTP_USE_TLS=true

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10

# Quiz Generation Settings
DEFAULT_QUESTIONS_PER_QUIZ=10
MIN_DEFINITIONS_FOR_GENERATION=8

# Optional LLM Settings (Gemini API for use_llm=true)
# LLM_API_KEY=your-gemini-api-key-here
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_MAX_TOKENS=4096
# RATE_LIMIT_LLM_MAX_REQUESTS=5
# RATE_LIMIT_LLM_WINDOW_SECONDS=60
