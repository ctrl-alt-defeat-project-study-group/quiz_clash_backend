// QuizClash Backend - Database schema (DBML)
// Import at https://dbdiagram.io  ->  "Import" -> "From DBML"  (or paste into the editor)
// Source of truth: app/db/models.py + alembic/versions/*  (head: 9e4b2c7a1d53)

Project quiz_clash {
  database_type: 'PostgreSQL'
  Note: '''
    # QuizClash Database
    Turn study files (CSV/TXT/PDF/DOCX) into multiple-choice quizzes, play solo,
    or host live multiplayer rooms.

    **Domains**
    - Auth: `users`, `email_tokens`, `user_settings`
    - Quizzes: `quizzes` -> `questions` -> `choices`
    - Solo play: `attempts` -> `attempt_answers`
    - Live play: `live_rooms` (players, scores and rounds live in server memory + WebSocket)

    **Conventions**
    - Integer primary keys in the DB; API exposes prefixed IDs (`quiz_N`, `q_N`, `att_N`).
    - Choice IDs `a`-`d` are derived from `choices.position` (not stored).
    - Every question has exactly 4 choices and exactly 1 correct choice (enforced in the API).
    - Deleting a parent cascades to children (`ON DELETE CASCADE`).
    - Alembic migrations manage the schema (no `create_all` at startup).
  '''
}

// ---------------------------------------------------------------- Auth

Table users {
  id integer [pk, increment]
  email varchar(255) [not null, unique, note: 'Login identifier']
  password_hash varchar(255) [not null, note: 'Argon2id hash']
  display_name varchar(100) [not null, default: 'User']
  role varchar(20) [not null, default: 'user', note: '"user" | "admin"']
  is_active boolean [not null, default: true, note: 'false = ACCOUNT_DISABLED']
  email_verified_at timestamptz [null, note: 'NULL = EMAIL_NOT_VERIFIED, login blocked']
  created_at timestamptz [default: `now()`]

  Indexes {
    id [name: 'ix_users_id']
    email [unique, name: 'ix_users_email']
  }

  Note: 'Accounts. Sign-up always creates role "user"; first admin is seeded from ADMIN_EMAIL/ADMIN_PASSWORD.'
}

Table email_tokens {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id]
  purpose varchar(20) [not null, note: '"verify" | "reset"']
  token_hash varchar(64) [not null, unique, note: 'SHA-256 of the raw one-time token']
  expires_at timestamptz [not null]
  used_at timestamptz [null, note: 'Set when the token is consumed']
  created_at timestamptz [default: `now()`]

  Indexes {
    id [name: 'ix_email_tokens_id']
    user_id [name: 'ix_email_tokens_user_id']
    token_hash [unique, name: 'ix_email_tokens_token_hash']
  }

  Note: 'One-time tokens for email verification and password reset.'
}

Table user_settings {
  id integer [pk, increment]
  user_id integer [not null, unique, ref: - users.id, note: '1-to-1 with users']
  theme varchar(20) [not null, default: 'system', note: 'light | dark | system']
  ui_language varchar(10) [not null, default: 'en', note: 'en | mm']
  default_questions integer [not null, default: 10, note: '5 | 10 | 15 | 20']
  difficulty varchar(30) [not null, default: 'Mixed', note: 'Mixed | Foundational | Advanced']
  quiz_language varchar(30) [not null, default: 'English']
  shuffle_questions boolean [not null, default: true]
  show_explanations boolean [not null, default: true]
  study_reminders boolean [not null, default: false]
  weekly_summary boolean [not null, default: true]
  updated_at timestamptz [default: `now()`]

  Indexes {
    id [name: 'ix_user_settings_id']
    user_id [unique, name: 'ix_user_settings_user_id']
  }

  Note: 'Per-user preferences (GET/PATCH /api/v1/settings). Created lazily with defaults.'
}

// ---------------------------------------------------------------- Quizzes

Table quizzes {
  id integer [pk, increment]
  owner_id integer [null, ref: > users.id, note: 'Quiz owner; admins can access all']
  title varchar(255) [not null, default: 'Untitled Quiz']
  category varchar(100) [null]
  source_type varchar(50) [not null, note: 'csv | txt | pdf | docx | structured | llm']
  source_filename varchar(255) [null, note: 'Original uploaded file name']
  source_hash varchar(64) [null, note: 'SHA-256 of parsed content + language, for duplicate detection']
  status varchar(50) [not null, default: 'ready', note: 'ready | draft | published | archived']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`, note: 'Refreshed on PATCH']

  Indexes {
    id [name: 'ix_quizzes_id']
    owner_id [name: 'ix_quizzes_owner_id']
    source_hash [name: 'ix_quizzes_source_hash']
  }

  Note: 'A generated quiz. API id: quiz_N.'
}

Table questions {
  id integer [pk, increment]
  quiz_id integer [not null, ref: > quizzes.id]
  prompt text [not null]
  position integer [not null, default: 0, note: 'Order inside the quiz']
  explanation text [null, note: 'Default "{term}: {definition}"']

  Indexes {
    id [name: 'ix_questions_id']
    quiz_id [name: 'ix_questions_quiz_id']
  }

  Note: 'Multiple-choice question. API id: q_N.'
}

Table choices {
  id integer [pk, increment]
  question_id integer [not null, ref: > questions.id]
  text text [not null]
  is_correct boolean [not null, default: false, note: 'Exactly 1 true per question; hidden by GET /quizzes/{id}']
  position integer [not null, default: 0, note: '0-3 -> API choice ids a-d']

  Indexes {
    id [name: 'ix_choices_id']
    question_id [name: 'ix_choices_question_id']
  }

  Note: 'Answer option. Exactly 4 per question.'
}

// ---------------------------------------------------------------- Solo attempts

Table attempts {
  id integer [pk, increment]
  quiz_id integer [not null, ref: > quizzes.id]
  user_id integer [null, ref: > users.id]
  score integer [not null, default: 0, note: 'Number of correct answers (graded server-side)']
  total_questions integer [not null]
  duration_seconds integer [null, note: 'Time spent taking the quiz']
  completed_at timestamptz [default: `now()`]

  Indexes {
    id [name: 'ix_attempts_id']
    quiz_id [name: 'ix_attempts_quiz_id']
    user_id [name: 'ix_attempts_user_id']
  }

  Note: 'One solo run of a quiz. API id: att_N (legacy attempt_N accepted on input).'
}

Table attempt_answers {
  id integer [pk, increment]
  attempt_id integer [not null, ref: > attempts.id]
  question_id integer [not null, ref: > questions.id]
  choice_id integer [not null, ref: > choices.id]
  is_correct boolean [not null]

  Indexes {
    id [name: 'ix_attempt_answers_id']
    attempt_id [name: 'ix_attempt_answers_attempt_id']
    question_id [name: 'ix_attempt_answers_question_id']
    choice_id [name: 'ix_attempt_answers_choice_id']
  }

  Note: 'Selected choice per question within an attempt.'
}

// ---------------------------------------------------------------- Live rooms

Table live_rooms {
  id integer [pk, increment]
  quiz_id integer [not null, ref: > quizzes.id]
  host_id integer [not null, ref: > users.id]
  pin varchar(6) [not null, unique, note: '6 digits; API shows "482 619"']
  timer_seconds integer [not null, default: 20, note: '5-120 seconds per round']
  status varchar(20) [not null, default: 'lobby', note: 'lobby | active | finished | closed']
  created_at timestamptz [default: `now()`]

  Indexes {
    id [name: 'ix_live_rooms_id']
    quiz_id [name: 'ix_live_rooms_quiz_id']
    host_id [name: 'ix_live_rooms_host_id']
    pin [unique, name: 'ix_live_rooms_pin']
  }

  Note: 'Persisted live room. Players, rounds, scores and leaderboard are held in memory (LiveRoomManager) and broadcast over WebSocket.'
}
